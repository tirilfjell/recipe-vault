rules_version = '2';

// Security rules for Cloud Firestore.
//
// These rules are what actually enforce "only authenticated users can read and
// write". Hiding the interface behind a login screen is not enough on its own,
// because a request can always be sent straight to the database.
//
// Deploy them from the Firebase console (Firestore Database -> Rules) or with
// the Firebase CLI: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Everything belonging to one user, including the favourites collection and
    // every saved recipe in it. Only that user may read or write it, and
    // request.auth is null for anonymous requests, so they are rejected by the
    // same condition.
    //
    // The recursive wildcard matches the collection path as well as the
    // documents under it. That matters because the app reads the saved recipes
    // with a collection query (see observeFavourites): Firestore checks a list
    // query against the collection path, which a rule written only for
    // /favourites/{recipeId} would not cover.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is closed. A new collection has to be granted access
    // deliberately rather than inheriting it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
